EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=859613727103-your-android-id-here.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-id-here.apps.googleusercontent.com
EXPO_PUBLIC_API_URL=https://api.graincraftapp.com/v1
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here
EXPO_PUBLIC_APP_ENV=production

# --- Phase 1: simple shop order email (EmailJS, no backend) ---
# See INTEGRATIONS.md section 3.1 for setup.
EXPO_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EXPO_PUBLIC_SHOP_OWNER_EMAIL=you@yourshop.com

# Optional: send orders to your own backend instead of email
# (set ORDER_DELIVERY: 'api' in src/config/featureFlags.ts)
EXPO_PUBLIC_ORDER_API_URL=

# Optional: Expo project id for push notifications (full app only)
EXPO_PUBLIC_PROJECT_ID=
